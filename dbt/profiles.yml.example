# Szablon połączenia z BigQuery. Skopiuj do profiles.yml (jest w .gitignore) albo ~/.dbt/profiles.yml.
#
# Wymagane zmienne środowiskowe (dev — domyślny target):
#   export BIGQUERY_PROJECT="twoj-projekt-gcp"
#   export BIGQUERY_KEYFILE="/sciezka/do/klucza/service-account.json"  # POZA folderem repo
# Tylko przy --target prod (osobna tożsamość):
#   export BIGQUERY_PROD_PROJECT="twoj-projekt-gcp-prod"
#   export BIGQUERY_PROD_KEYFILE="/sciezka/do/klucza/service-account-prod.json"
#
# Konto serwisowe potrzebuje: BigQuery Data Viewer na datasecie GA4, BigQuery Data Editor
# na datasecie docelowym, BigQuery Job User w projekcie.
testy_ab: # musi pasować do `profile:` w dbt_project.yml
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      keyfile: "{{ env_var('BIGQUERY_KEYFILE') }}"
      project: "{{ env_var('BIGQUERY_PROJECT') }}"
      dataset: dbt_dev_testy_ab
      # Musi się zgadzać z lokalizacją datasetu GA4 — BigQuery nie łączy danych między regionami.
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      # Twardy limit bajtów na zapytanie: po przekroczeniu zapytanie pada bez opłaty.
      # Pierwszy --full-refresh stg_ga4__zdarzenia czyta kilka kolumn z każdego dnia od ga4_data_startu —
      # przy dużym ruchu podnieś limit świadomie, zamiast go usuwać.
      maximum_bytes_billed: 10737418240   # 10 GiB

    # Prod ma własne zmienne bez fallbacku na dev: przypadkowe --target prod z kluczem dev nie połączy się.
    prod:
      type: bigquery
      method: service-account
      keyfile: "{{ env_var('BIGQUERY_PROD_KEYFILE') }}"
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_prod_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 107374182400  # 100 GiB

    # Prod z harmonogramu GitHub Actions (.github/workflows/dbt-build.yml). oauth = Application
    # Default Credentials, które ustawia google-github-actions/auth z tokenu Workload Identity
    # Federation — bez pliku klucza. service-account nie przyjmie poświadczeń external_account z WIF.
    prod_ci:
      type: bigquery
      method: oauth
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_prod_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 107374182400  # 100 GiB

    # CI (.github/workflows/dbt.yml): pusty build i unit testy przed wdrożeniem. Ten sam projekt
    # i konto co prod_ci, ale osobny dataset, w którym tabele wygasają po godzinie.
    ci:
      type: bigquery
      method: oauth
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_ci_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 1073741824  # 1 GiB — pusty build i unit testy czytają ułamki MB
