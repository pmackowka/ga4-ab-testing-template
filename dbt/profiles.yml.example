# Szablon połączenia z BigQuery. Skopiuj do profiles.yml (jest w .gitignore) albo ~/.dbt/profiles.yml.
# Wszystkie targety logują się przez oauth, bez plików kluczy kont serwisowych.
#
# sandbox (domyślny) — lokalnie, BigQuery sandbox bez billingu w projekcie ab-test-sandbox (EU):
#   gcloud auth application-default login
#
# ci, prod_ci — tylko GitHub Actions: token konta serwisowego dbt-prod z Workload Identity Federation,
# projekt z sekretu BIGQUERY_PROD_PROJECT (dbt/README.md, sekcja „Konfiguracja GCP”).
# Konto serwisowe potrzebuje: BigQuery Data Viewer na datasecie GA4, BigQuery Data Editor
# na datasecie docelowym, BigQuery Job User w projekcie.
testy_ab:
  target: sandbox
  outputs:
    sandbox:
      type: bigquery
      method: oauth
      project: ab-test-sandbox
      dataset: dbt_dev_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 10737418240

    prod_ci:
      type: bigquery
      method: oauth
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_prod_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 107374182400

    ci:
      type: bigquery
      method: oauth
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_ci_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 1073741824
