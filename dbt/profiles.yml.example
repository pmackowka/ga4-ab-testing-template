testy_ab:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: oauth
      project: twoj-projekt
      dataset: dbt_dev_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 10737418240

    prod_ci:
      type: bigquery
      method: oauth
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_prod_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 107374182400

    ci:
      type: bigquery
      method: oauth
      project: "{{ env_var('BIGQUERY_PROD_PROJECT') }}"
      dataset: dbt_ci_testy_ab
      location: EU
      priority: interactive
      threads: 4
      job_execution_timeout_seconds: 300
      job_retries: 1
      maximum_bytes_billed: 1073741824
